# -- Generic / cross-platform build artifact ignore rules --

# .NET build output
bin/
obj/

# Node.js dependencies
node_modules/

# Python virtual environments / caches
venv/
__pycache__/
*.pyc

# Environment files
.env
.env.*
!.env.example

# IDE / editor
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.user
*.sw?

# OS files
.DS_Store
Thumbs.db

# Logs
*.log
logs/
