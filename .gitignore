# -- Generic / cross-platform build artifact ignore rules --

# .NET build output
bin/
obj/
/.fitness-build/
/.fitness-build-check/
/.fitness-build-check-tests/

# Node.js dependencies
node_modules/

# Python virtual environments / caches
venv/
.venv/
__pycache__/
*.pyc

# Environment files
.env
.env.*
!.env.example

# IDE / editor
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.user
*.sw?

# OS files
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Generated test/perf reports (CI uploads them as artifacts)
BackendAPI/GymAgentService/reports/
BackendAPI/GymAgentService/.coverage
BackendAPI/GymAgentService/coverage.xml
BackendAPI/GymAgentService/junit.xml
BackendAPI/DietPlanService/reports/
BackendAPI/DietPlanService/.coverage
BackendAPI/DietPlanService/coverage.xml
BackendAPI/DietPlanService/tests/_test_diet.sqlite3

# Chroma DB files
BackendAPI/GymAgentService/chroma_gym_data/

AI_Adaptive_Fitness_Gym_Agent_Assignment_Prompt.md

/.fitness-build-check-bin/
BackendAPI/.fitness-build-check-obj/
BackendAPI/.fitness-build-check-tests-bin/

# Local tooling / test caches
.kilo/
.coverage
.pytest_cache/
