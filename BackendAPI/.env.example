# =====================================================================================
# VitroFit - the ONE environment file for the whole backend.
#
#   cp .env.example .env     (Windows: copy .env.example .env)   then fill in the values.
#
# Read by:
#   * VitroFit.API (.NET)  - DotNetEnv loads it at start-up; "__" in a name maps to ":" in appsettings.
#   * every Python service - chatbot, Gym, Diet (python-dotenv) and Fitness, Time (pydantic-settings).
#     VitroFit.API also passes this environment on to the services it starts, so values here always win.
# There are NO per-service .env files. Never commit .env (it is git-ignored); only this template is tracked.
# Lines starting with "#" are optional: the shown value is the default used when the line is absent.
# =====================================================================================

# ---- Database -----------------------------------------------------------------------
# .NET (EF Core / Npgsql):  Host=localhost;Port=5432;Database=VitroFit;Username=postgres;Password=...
ConnectionStrings__DefaultConnection=
# Python SQLAlchemy services (Gym + Diet):  postgresql+psycopg2://user:password@localhost:5432/VitroFit
DATABASE_URL=
# Python LangGraph checkpointer (Fitness + Time; same database, psycopg 3 style):  postgresql://user:password@localhost:5432/VitroFit
FITNESS_DATABASE_URL=

# ---- Auth, email, uploads (VitroFit.API) ---------------------------------------------
# Signing key for access tokens. Use 32+ random characters. DietPlanService reads the same key to re-verify tokens.
JwtSettings__Secret=
# Only needed if you change the issuer/audience in appsettings.json (DietPlanService must match them):
# JwtSettings__Issuer=VitroFitApi
# JwtSettings__Audience=VitroFitWeb
EmailSettings__Password=
Cloudinary__ApiKey=
Cloudinary__ApiSecret=

# ---- Service keys (shared secrets between the .NET API and the Python agents) ----------
# Each pair must hold the SAME value (32+ characters, otherwise the API refuses to call the service).
#   Gym:      GYM_AGENT_KEY      = GymAgent__ServiceKey      (required)
#   Fitness:  FITNESS_SERVICE_KEY = FitnessAgent__ServiceKey  (required)
#   Diet:     DIET_AGENT_KEY     = DietAgent__ServiceKey     (optional: when set, only the API can call the Diet service)
GYM_AGENT_KEY=
GymAgent__ServiceKey=
FITNESS_SERVICE_KEY=
FitnessAgent__ServiceKey=
# DIET_AGENT_KEY=
# DietAgent__ServiceKey=

# ---- LLM providers --------------------------------------------------------------------
# NVIDIA NIM: chatbot, Diet and (by default) Gym.   OpenRouter: Fitness, Time and (optionally) Gym.
NVIDIA_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# ---- chatbot_service (port 8000) -------------------------------------------------------
NVIDIA_MODEL_PRIMARY=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_MODEL_FALLBACK=openai/gpt-oss-20b

# ---- DietPlanService (port 8003) - every line optional (defaults shown) ---------------------
# DIET_NVIDIA_MODEL_PRIMARY=meta/llama-3.2-11b-vision-instruct
# DIET_NVIDIA_MODEL_FALLBACK=meta/llama-3.2-11b-vision-instruct
# Comma-separated Host headers the service accepts; empty means no restriction.
# DIET_ALLOWED_HOSTS=
# DIET_MAX_CONCURRENT_WORKFLOWS=3
# Seconds; 0 = on restart, mark every interrupted run (no age limit).
# DIET_RECOVER_MAX_AGE_SECONDS=0
# Prompt-injection guard: enforce (block) or monitor (log only).
# DIET_INJECTION_MODE=enforce
# DIET_INJECTION_BLOCK_SCORE=
# DIET_LOG_LEVEL=INFO
# Only used when you run the Diet service by hand (python main.py).
# PORT=8003

# ---- GymAgentService (port 8001) ---------------------------------------------------------
# LLM provider: nvidia or openrouter (the matching *_API_KEY above must be set).
LLM_PROVIDER=nvidia
NVIDIA_MODEL=openai/gpt-oss-20b
# gpt-oss models only: low, medium or high.
# NVIDIA_REASONING_EFFORT=low
# OPENROUTER_REASONING=off
TAVILY_API_KEY=
GOOGLE_PLACES_API_KEY=
CHROMA_PERSIST_DIR=./chroma_gym_data
CACHE_STALE_DAYS=30
# WORKOUT_CACHE_STALE_DAYS=30
# Agent behaviour (defaults shown)
AGENT_MAX_RETRIES=2
AGENT_SCRAPE_TIMEOUT=10
AGENT_CONFIDENCE_THRESHOLD=0.6
AGENT_MAX_STEPS=4
# AGENT_MAX_SEARCH_CALLS=3
# AGENT_LLM_TIMEOUT=60
# AGENT_TOOL_TIMEOUT=20
# AGENT_RETRY_BACKOFF=1.5
# AGENT_EXTRACTION_MAX_TOKENS=2500
# Workflow limits and safety (defaults shown)
# GYM_WORKFLOW_BUDGET_SECONDS=600
# GYM_MAX_CONCURRENT_WORKFLOWS=2
# postgres (default) or memory; memory is for tests and development only.
# GYM_CHECKPOINTER=postgres
# GYM_ALLOWED_HOSTS=127.0.0.1,localhost
# Sites (besides the gym's own website) the agent may cite as evidence. Setting this REPLACES the built-in list:
# GYM_URL_ALLOWLIST=facebook.com,instagram.com,tripadvisor.com,yelp.com,maps.google.com
# GYM_INJECTION_MODE=enforce
# GYM_INJECTION_BLOCK_SCORE=9
# GYM_LOG_LEVEL=INFO
# Time agent prompt-injection guard (enforce blocks, monitor only logs)
# TIME_INJECTION_MODE=enforce
# TIME_INJECTION_BLOCK_SCORE=3

# ---- FitnessAgentService (port 8002) ------------------------------------------------------
# Calls back into the .NET API to record progress (use the API's http address).
FITNESS_API_URL=http://localhost:5284
# Uses: FITNESS_SERVICE_KEY, FITNESS_DATABASE_URL, OPENROUTER_API_KEY, OPENROUTER_MODEL (all above).

# ---- TimeManagementAgentService (port 8004) -------------------------------------------------
# Uses only: FITNESS_DATABASE_URL, OPENROUTER_API_KEY, OPENROUTER_MODEL (all above). It has no service key.
# TIME_MANAGEMENT_PORT=8004
