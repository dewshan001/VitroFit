# VitroFit backend - single environment file for every service.
# Loaded by: the .NET API (DotNetEnv), and chatbot / Gym / Diet / Fitness / TimeManagement (python-dotenv / pydantic).
# Never commit this file (git-ignored). Copy .env.example and fill in values.

# ---- Shared LLM keys ----
NVIDIA_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# ---- chatbot_service (port 8000) ----
NVIDIA_MODEL_PRIMARY=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_MODEL_FALLBACK=openai/gpt-oss-20b

# ---- GymAgentService (port 8001) ----
DATABASE_URL=
CACHE_STALE_DAYS=30
LLM_PROVIDER=nvidia
NVIDIA_MODEL=openai/gpt-oss-20b
TAVILY_API_KEY=
AGENT_MAX_RETRIES=2
AGENT_SCRAPE_TIMEOUT=10
AGENT_CONFIDENCE_THRESHOLD=0.6
AGENT_MAX_STEPS=4
CHROMA_PERSIST_DIR=./chroma_gym_data
GOOGLE_PLACES_API_KEY=
GYM_AGENT_KEY=

# ---- FitnessAgentService (8002) + TimeManagementAgentService (8004) ----
FITNESS_SERVICE_KEY=
FITNESS_API_URL=
FITNESS_DATABASE_URL=

# ---- DietPlanService (8003) - optional, defaults apply when unset ----
# DIET_NVIDIA_MODEL_PRIMARY=
# DIET_NVIDIA_MODEL_FALLBACK=
# DIET_AGENT_KEY=
# DIET_ALLOWED_HOSTS=

# ---- VitroFit.API (.NET) - ASP.NET maps '__' to ':' in appsettings ----
ConnectionStrings__DefaultConnection=
JwtSettings__Secret=
Cloudinary__ApiKey=
Cloudinary__ApiSecret=
EmailSettings__Password=
FitnessAgent__ServiceKey=
GymAgent__ServiceKey=
# DietAgent__ServiceKey=
