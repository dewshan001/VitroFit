# â”€â”€ Database â”€â”€
DATABASE_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD@localhost:5432/VitroFit
CACHE_STALE_DAYS=30

# â”€â”€ LLM (NVIDIA NIM â€” preferred, own quota separate from OpenRouter) â”€â”€
# Get a key at https://build.nvidia.com
NVIDIA_API_KEY=nvapi-...
NVIDIA_MODEL=mistralai/mistral-nemotron

# â”€â”€ LLM (OpenRouter â€” fallback, used only if NVIDIA_API_KEY is unset) â”€â”€
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_MODEL=inclusionai/ling-3.0-flash-sante:free
# nvidia | openrouter | empty = auto (NVIDIA when its key is set)
LLM_PROVIDER=openrouter
# off (default) | low | medium | high | empty = send nothing. Off avoids empty answers from reasoning models.
OPENROUTER_REASONING=off

# â”€â”€ LangSmith Observability (Optional) â”€â”€
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_pt_...
# LANGSMITH_PROJECT=vitrofit-gym-agent

# â”€â”€ Tavily Web Search (Optional â€” search_gym_info tool degrades gracefully without it) â”€â”€
TAVILY_API_KEY=tvly-...

# â”€â”€ Agent Configuration â”€â”€
AGENT_MAX_RETRIES=2
AGENT_SCRAPE_TIMEOUT=10
AGENT_CONFIDENCE_THRESHOLD=0.6
AGENT_MAX_STEPS=4

# â”€â”€ Vector Store â”€â”€
CHROMA_PERSIST_DIR=./chroma_gym_data

# -- Multi-agent workflow --
# Shared secret ASP.NET sends as X-Gym-Agent-Key (min 32 chars). Same value in the API config.
GYM_AGENT_KEY=change-me-to-a-random-string-of-32+chars
GYM_WORKFLOW_BUDGET_SECONDS=600
GYM_MAX_CONCURRENT_WORKFLOWS=2
# gpt-oss models only: low | medium | high | empty = model default
NVIDIA_REASONING_EFFORT=low
AGENT_TOOL_TIMEOUT=20
AGENT_LLM_TIMEOUT=60
# postgres (default, durable) or memory (tests only)
GYM_CHECKPOINTER=postgres
# Domains (besides the gym's own website) whose pages may be cited as evidence. Comma-separated;
# subdomains match, look-alikes do not. Empty = only the gym's own site.
GYM_URL_ALLOWLIST=facebook.com,instagram.com,tripadvisor.com,yelp.com,maps.google.com

# -- Prompt-injection guard (injection_guard.py) --
# enforce (default): remove suspicious sentences, withhold hostile sources. monitor: only detect and record.
GYM_INJECTION_MODE=enforce
# Total signal weight at which a whole source is withheld (a strong signal weighs 3, a weak one 1).
GYM_INJECTION_BLOCK_SCORE=9

# -- Logging (callbacks.py) --
GYM_LOG_LEVEL=INFO
