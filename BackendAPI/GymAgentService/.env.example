# ── Database ──
DATABASE_URL=postgresql+psycopg2://postgres:12345678@localhost:5432/VitroFit
CACHE_STALE_DAYS=30

# ── LLM (NVIDIA NIM — preferred, own quota separate from OpenRouter) ──
# Get a key at https://build.nvidia.com
NVIDIA_API_KEY=nvapi-...
NVIDIA_MODEL=mistralai/mistral-nemotron

# ── LLM (OpenRouter — fallback, used only if NVIDIA_API_KEY is unset) ──
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free

# ── LangSmith Observability (Optional) ──
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_pt_...
# LANGSMITH_PROJECT=vitrofit-gym-agent

# ── Tavily Web Search (Optional — search_gym_info tool degrades gracefully without it) ──
TAVILY_API_KEY=tvly-...

# ── Agent Configuration ──
AGENT_MAX_RETRIES=2
AGENT_SCRAPE_TIMEOUT=10
AGENT_CONFIDENCE_THRESHOLD=0.6
AGENT_MAX_STEPS=6

# ── Vector Store ──
CHROMA_PERSIST_DIR=./chroma_gym_data
