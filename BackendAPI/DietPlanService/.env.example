DATABASE_URL=postgresql+psycopg2://postgres:12345678@localhost:5432/VitroFit
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_MODEL_PRIMARY=meta/llama-3.2-11b-vision-instruct
NVIDIA_MODEL_FALLBACK=meta/llama-3.2-11b-vision-instruct
PORT=8003

# JWT signing key/issuer/audience are read from ../VitroFit.API/appsettings.json (JwtSettings); no entry needed here.

# Shared key (32+ random characters). When set, only the ASP.NET API can call this service. Use the same value as DietAgent:ServiceKey in VitroFit.API.
DIET_AGENT_KEY=
# Comma-separated Host names this service accepts, e.g. 127.0.0.1,localhost. Empty = any.
DIET_ALLOWED_HOSTS=
# Plan generations/edits that may use the LLM at the same time.
DIET_MAX_CONCURRENT_WORKFLOWS=3
# enforce = refuse instruction-like text, monitor = only record it.
DIET_INJECTION_MODE=enforce
# DEBUG | INFO | WARNING | ERROR
DIET_LOG_LEVEL=INFO
